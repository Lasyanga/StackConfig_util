<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apache / PHP / MariaDB Configuration Utility"
        Height="780" Width="600" MinHeight="620" MinWidth="560" MaxWidth="640"
        Background="#1A1A2E" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Background" Value="#2A2A4A"/>
            <Setter Property="Foreground" Value="#E0E0F0"/>
            <Setter Property="BorderBrush" Value="#44446A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#41417A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#252538"/>
                                <Setter Property="Foreground" Value="#69697D"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C7C7E2"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#A7A7D0"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="29"/>
            <Setter Property="Padding" Value="6,4,6,4"/>
            <Setter Property="Background" Value="#0F0F1E"/>
            <Setter Property="Foreground" Value="#EEEEFF"/>
            <Setter Property="BorderBrush" Value="#343455"/>
            <Setter Property="CaretBrush" Value="#AAAAEE"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="APACHE / PHP / MARIADB CONFIGURATION"
                       Foreground="#9999FF" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Configuration only. Programs must already be installed. Files are backed up before changes."
                       Foreground="#8585A8" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,12"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Apache folder:" VerticalAlignment="Center" Margin="0,0,10,5"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtApachePath" Text="C:\Apache24" Margin="0,0,0,5"
                         ToolTip="Usually C:\Apache24. This utility does not install Apache."/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="PHP 7.3 TS folder:" VerticalAlignment="Center" Margin="0,0,10,5"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtPhpPath" Text="C:\Apache\php73" Margin="0,0,0,5"
                         ToolTip="Use a Non-Thread-Safe PHP 7.3 build for mod_fcgid."/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="MariaDB folder:" VerticalAlignment="Center" Margin="0,0,10,5"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtMariaDBPath" Text="C:\MariaDB" Margin="0,0,0,5"
                         ToolTip="Change this if MariaDB was installed in another folder, such as C:\Program Files\MariaDB 11.4."/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Document root:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtDocumentRoot" Text="C:\Apache24\htdocs"
                         ToolTip="Apache DocumentRoot. The Apache configuration button will update httpd.conf to this folder."/>
            </Grid>
            <TextBlock Text="Optional PHP extensions (comma-separated; unavailable DLLs are skipped):"
                       Foreground="#8585A8" FontSize="10" Margin="0,6,0,0"/>
            <TextBox x:Name="txtExtensions" Text="mysqli, pdo_mysql, mbstring, curl, gd, zip"
                     ToolTip="The utility enables these only when their DLLs are present and PHP can load the resulting configuration."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Expander Header="1. Prerequisites and backups" IsExpanded="True">
                    <StackPanel Margin="0,7,0,0">
                        <Button x:Name="btnCheck" Content="Check installed files"/>
                        <Button x:Name="btnBackup" Content="Back up all configuration files"/>
                        <Button x:Name="btnListBackups" Content="List configuration backups"/>
                        <Button x:Name="btnRestore" Content="Restore latest configuration backups"/>
                    </StackPanel>
                </Expander>

                <Expander Header="2. Apache and PHP configuration" IsExpanded="True">
                    <StackPanel Margin="0,7,0,0">
                        <Button x:Name="btnHttpd" Content="Update httpd.conf (include and DocumentRoot)"/>
                        <Button x:Name="btnFcgid" Content="Create mod_fcgid configuration"/>
                        <Button x:Name="btnPhpIni" Content="Configure php.ini for PHP 7.3 FastCGI"/>
                    </StackPanel>
                </Expander>

                <Expander Header="3. MariaDB configuration" IsExpanded="True">
                    <StackPanel Margin="0,7,0,0">
                        <Button x:Name="btnMariaIni" Content="Create MariaDB my.ini"/>
                        <Button x:Name="btnMariaDataBackup" Content="Back up MariaDB data directory"
                                ToolTip="Copies the whole MariaDB data folder to a timestamped folder. The MariaDB service is stopped and restarted automatically during the copy."/>
                        <Button x:Name="btnMariaInit" Content="Initialize MariaDB data directory"/>
                        <Button x:Name="btnMariaService" Content="Install MariaDB Windows service"/>
                        <Button x:Name="btnMariaSecure" Content="Set root password and clean up MariaDB"/>
                        <Button x:Name="btnMariaTest" Content="Test local MariaDB connection"/>
                    </StackPanel>
                </Expander>

                <Expander Header="4. Windows integration" IsExpanded="True">
                    <StackPanel Margin="0,7,0,0">
                        <Button x:Name="btnEnvironment" Content="Set machine environment variables (PHPRC and PATH)"/>
                        <Button x:Name="btnApacheService" Content="Install Apache Windows service"/>
                        <Button x:Name="btnFirewall" Content="Create firewall rules (80, 443, local 3306)"/>
                    </StackPanel>
                </Expander>

                <Expander Header="5. Validate and test" IsExpanded="True">
                    <StackPanel Margin="0,7,0,0">
                        <Button x:Name="btnValidate" Content="Validate Apache configuration (httpd -t)"/>
                        <Button x:Name="btnStart" Content="Start installed services"/>
                        <Button x:Name="btnPhpInfo" Content="Create phpinfo.php test page"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,10,0,3">
            <DockPanel LastChildFill="False" Margin="0,0,0,3">
                <TextBlock Text="Activity log" Foreground="#8585A8" FontSize="11" VerticalAlignment="Center"/>
                <Button x:Name="btnLogPopout" Content="Popout log" Height="24" Width="85" Margin="8,0,0,0" FontSize="10"/>
                <Button x:Name="btnLogSave" Content="Save log" Height="24" Width="75" Margin="6,0,0,0" FontSize="10"/>
                <Button x:Name="btnLogClear" Content="Clear log" Height="24" Width="75" Margin="6,0,0,0" FontSize="10"/>
            </DockPanel>
            <TextBox x:Name="txtLog" Height="125" Background="#0F0F1E" Foreground="#99DD99"
                     FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" Padding="7"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="txtStatus" Grid.Column="0" Text="Status: Ready" Foreground="#9999FF" FontSize="11"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
            <Button x:Name="btnClose" Grid.Column="1" Content="EXIT" Width="86" Height="34"
                    Background="#3D0000" Foreground="#FF8585" BorderBrush="#7C2525" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
